[Unit]
Description=Doxie Pro & Inbox Auto-Export Searchable PDF Watcher
After=doxie-scanner.service
Wants=doxie-scanner.service

[Service]
Type=simple
EnvironmentFile=-%h/.config/doxie-scanner/env
ExecStart=%h/.local/bin/doxie-auto-export --watch
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
