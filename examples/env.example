# Copy to ~/.config/doxie-scanner/env and customize for your machine.
# After editing, run: doxie service restart

# Raw Doxie Pro scan job storage (kept local; not synced)
DOXIE_DATA_DIR=~/Scans/doxie
DOXIE_LISTEN_ADDR=127.0.0.1:8400
DOXIE_BUTTON_DUPLEX=1
DOXIE_BUTTON_AUTOCROP=0
DOXIE_OCR_LANG=eng

# Unified Scans inbox (searchable PDFs land here and are reviewed by Doxie Filer)
DOXIE_PDF_DIR=~/Scans
DOXIE_INBOX_DIR=~/Scans
DOXIE_PDF_JPEG_QUALITY=88
DOXIE_WATCH_INCOMING=1

# Optional: network eSCL/SANE scanner device (find yours with `scanimage -L`)
# DOXIE_CANON_DEVICE=escl:http://192.168.1.50:80

# Doxie Filer (local LLM recommendation + human-in-the-loop approval)
DOXIE_TARGET_ROOT=~/Documents
DOXIE_FILER_LISTEN_ADDR=127.0.0.1:8401
DOXIE_LMSTUDIO_URL=http://127.0.0.1:1234
DOXIE_FILER_MODEL_FAST=qwen/qwen3.5-4b
DOXIE_FILER_MODEL_STRONG=qwen/qwen3.8-27b

# Optional: household/folder hints profile (copy from examples/profile.example.json)
# DOXIE_PROFILE_FILE=~/.config/doxie-scanner/profile.json

# Optional: Paperless-ngx integration for doxie-scanner-server
# DOXIE_PAPERLESS_URL=http://paperless.lan:8000
# DOXIE_PAPERLESS_TOKEN=your-token-here
