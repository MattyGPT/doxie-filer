#!/usr/bin/env python3
"""Local Web Inbox GUI for reviewing, approving, and filing scanned PDFs."""

from __future__ import annotations

import json
import os
import sys
import threading
import urllib.parse
from http import HTTPStatus
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path

for _p in (Path(__file__).resolve().parent.parent, Path.home() / ".local" / "share" / "doxie-filer"):
    if str(_p) not in sys.path:
        sys.path.insert(0, str(_p))
try:
    from doxie_filer import core
except ImportError:
    import filer_core as core


class BatchAnalyzer:
    """Runs background sequential LLM analysis for all uncached inbox PDFs."""

    def __init__(self) -> None:
        self._lock = threading.Lock()
        self._running = False
        self._cancel = False
        self._tier = "fast"
        self._total = 0
        self._done = 0
        self._failed = 0
        self._current: str | None = None

    def status(self) -> dict:
        with self._lock:
            return {
                "running": self._running,
                "tier": self._tier,
                "total": self._total,
                "done": self._done,
                "failed": self._failed,
                "current": self._current,
            }

    def stop(self) -> dict:
        with self._lock:
            if self._running:
                self._cancel = True
            return {
                "running": self._running,
                "tier": self._tier,
                "total": self._total,
                "done": self._done,
                "failed": self._failed,
                "current": self._current,
                "cancelling": self._cancel,
            }

    def start(self, cfg: dict, tier: str = "fast", force: bool = False) -> dict:
        with self._lock:
            if self._running:
                return {
                    "running": True,
                    "tier": self._tier,
                    "total": self._total,
                    "done": self._done,
                    "failed": self._failed,
                    "current": self._current,
                }
            items = core.list_inbox_pdfs(cfg["inbox_dir"])
            targets: list[Path] = []
            for item in items:
                p = Path(item["path"])
                if not force and core.get_cached_recommendation(p, cfg) is not None:
                    continue
                targets.append(p)
            if not targets:
                return {
                    "running": False,
                    "tier": tier,
                    "total": 0,
                    "done": 0,
                    "failed": 0,
                    "current": None,
                }
            self._running = True
            self._cancel = False
            self._tier = tier
            self._total = len(targets)
            self._done = 0
            self._failed = 0
            self._current = targets[0].name

        t = threading.Thread(target=self._worker, args=(cfg, targets, tier, force), daemon=True)
        t.start()
        return self.status()

    def _worker(self, cfg: dict, targets: list[Path], tier: str, force: bool) -> None:
        try:
            for pdf in targets:
                with self._lock:
                    if self._cancel:
                        break
                    self._current = pdf.name
                if not pdf.is_file():
                    with self._lock:
                        self._done += 1
                    continue
                try:
                    rec = core.recommend_for_pdf(pdf, cfg=cfg, tier=tier, bypass_cache=force)
                    with self._lock:
                        self._done += 1
                        if rec.get("fallback"):
                            self._failed += 1
                except Exception as exc:
                    sys.stderr.write(f"[doxie-filer] batch error on {pdf.name}: {exc}\n")
                    with self._lock:
                        self._done += 1
                        self._failed += 1
        finally:
            with self._lock:
                self._running = False
                self._cancel = False
                self._current = None


BATCH = BatchAnalyzer()

